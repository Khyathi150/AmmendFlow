# AmendFlow Environment Configuration Template

# Backend Server Configuration
PORT=5000
HOST=0.0.0.0
NODE_ENV=development

# MongoDB Connection String (Required in production; blank uses local MongoMemoryServer in development/test only)
MONGODB_URI=

# Authentication Secrets (Required in production: >= 32 characters random high-entropy secret)
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Exact Frontend Origin URL (Required in production for strict CORS, e.g. https://amendflow.vercel.app)
CLIENT_URL=http://localhost:5173

# Optional Public Backend Origin URL (e.g. https://amendflow-api.onrender.com)
PUBLIC_API_URL=

# Document Storage Configuration ("cloudinary" required in production; "local" supported in development)
STORAGE_PROVIDER=local
UPLOAD_DIR=./uploads

# Cloudinary Persistent Storage (Backend-only secrets; required when STORAGE_PROVIDER=cloudinary or NODE_ENV=production)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=amendflow

# Explicit Non-Production Demo Seeding Controls (Never enable in production)
ALLOW_DEMO_SEED=false
SEED_DEMO_PASSWORD=
