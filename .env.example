# AmendFlow Environment Configuration Template

# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Leave blank to use automatic embedded in-memory MongoDB)
MONGODB_URI=

# Authentication Secrets
JWT_SECRET=your-super-secure-jwt-secret-at-least-32-characters
JWT_EXPIRES_IN=7d

# CORS & Client Application URL
CLIENT_URL=http://localhost:5173

# File Upload Storage Directory
UPLOAD_DIR=./uploads
