# AmendFlow Environment Configuration Template

# Backend Server Configuration
PORT=5000
HOST=0.0.0.0
NODE_ENV=development

# MongoDB Connection String (Required in production; blank uses local MongoMemoryServer in development/test)
MONGODB_URI=

# Authentication Secrets (Required in production: >= 32 characters random high-entropy secret)
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Exact Frontend Origin URL (Required in production for strict CORS, e.g. https://amendflow.vercel.app)
CLIENT_URL=http://localhost:5173

# Optional Public Backend Origin URL (if behind custom proxy/load balancer)
PUBLIC_API_URL=

# Document Storage Configuration ("s3" required in production; "local" supported in development)
STORAGE_PROVIDER=local
UPLOAD_DIR=./uploads

# S3-Compatible Persistent Object Storage (Required when STORAGE_PROVIDER=s3 or NODE_ENV=production)
# Works with AWS S3, Cloudflare R2, DigitalOcean Spaces, MinIO, Backblaze B2
S3_BUCKET=
S3_REGION=ap-south-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
S3_PUBLIC_URL=
S3_SIGNED_URL_EXPIRES_SEC=900
